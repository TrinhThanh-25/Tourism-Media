### Example .env for the Database Travel project
### Copy this file to `.env` and fill in values for your local machine:

# Path to SQLite database file (relative to project root)
# If you want data in a subfolder, e.g. ./data/travel_app.db, make sure the folder exists.
DB_PATH=./data/travel_app.db

# Uploaded avatar/trip images are kept outside Git in this local directory.
UPLOAD_DIR=./data/uploads
# Optional. Set this to an address reachable by Android devices on your network.
# Emulator example: http://10.0.2.2:3000 ; physical device example: http://192.168.1.10:3000
PUBLIC_BASE_URL=http://10.0.2.2:3000

# Server port
PORT=3000

# Required in every environment. Generate a private random value; never commit .env.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated emails promoted to admin during startup.
ADMIN_EMAILS=admin@example.com

CORS_ORIGIN=http://localhost:3000

# Global request limit per IP (authentication routes use a stricter limit).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
