<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TourismMedia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnPrimaryContainer">@color/forest</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/mint</item>
        <item name="colorOnSecondaryContainer">@color/forest</item>
        <item name="colorTertiary">@color/green</item>
        <item name="colorTertiaryContainer">@color/mint</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/cream</item>
        <item name="colorSurfaceVariant">@color/cream</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorAccent">@color/forest</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="materialButtonStyle">@style/TourismButton</item>
    </style>

    <style name="Theme.TourismMedia" parent="Base.Theme.TourismMedia" />
    <style name="TourismButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TourismBottomText" parent="TextAppearance.Material3.LabelSmall"><item name="android:textSize">10sp</item><item name="android:textStyle">bold</item></style>
    <style name="ProfileMenuRow">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">58dp</item>
        <item name="android:layout_marginBottom">9dp</item><item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item><item name="android:paddingHorizontal">15dp</item>
    </style>
    <style name="ProfileMenuIcon"><item name="android:layout_width">38dp</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">21sp</item><item name="android:textColor">@color/forest</item></style>
    <style name="ProfileMenuLabel"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textColor">@color/ink</item></style>
    <style name="ProfileMenuArrow"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/muted</item><item name="android:textSize">16sp</item></style>
</resources>
