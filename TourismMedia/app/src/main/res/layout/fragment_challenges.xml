<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F4EC" android:orientation="vertical" android:padding="16dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đi để trưởng thành" android:textColor="#17332B" android:textSize="29sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hoàn thành thử thách và mở khóa phần thưởng." android:textColor="#718078"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="18dp" android:background="@drawable/bg_hero" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Điểm hiện có" android:textColor="#C9DED3"/><TextView android:id="@+id/challenge_points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.450" android:textColor="@android:color/white" android:textSize="32sp" android:textStyle="bold"/></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/open_rewards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đổi quà" android:textColor="#3A2B13" app:backgroundTint="#FFB84D"/></LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="Thử thách dành cho bạn" android:textColor="#17332B" android:textSize="20sp" android:textStyle="bold"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/challenges_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
