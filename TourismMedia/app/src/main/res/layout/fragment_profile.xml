<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
 <FrameLayout android:layout_width="match_parent" android:layout_height="145dp"><ImageView android:id="@+id/profile_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Ảnh bìa du lịch" android:scaleType="centerCrop"/><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_image_scrim"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:padding="20dp" android:text="Tài khoản" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/></FrameLayout>
 <TextView android:id="@+id/profile_avatar" android:layout_width="88dp" android:layout_height="88dp" android:layout_marginTop="-44dp" android:background="@drawable/bg_hero" android:elevation="8dp" android:gravity="center" android:text="TA" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold"/>
 <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Traveler" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/><TextView android:id="@+id/profile_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="traveler@example.com" android:textColor="@color/muted"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/edit_profile" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chỉnh sửa hồ sơ" android:textColor="@color/green"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:gravity="center" android:orientation="horizontal" android:padding="16dp"><TextView android:id="@+id/profile_points" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="0\nĐiểm" android:textColor="@color/ink" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="—\nChuyến đi" android:textColor="@color/ink" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="—\nCheck-in" android:textColor="@color/ink" android:textStyle="bold"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:orientation="vertical">
  <LinearLayout android:id="@+id/profile_saved" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="♡" android:textColor="@color/coral" android:textSize="21sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Địa điểm và chuyến đi đã lưu" android:textColor="@color/ink"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/muted" android:textSize="24sp"/></LinearLayout>
  <LinearLayout android:id="@+id/profile_checkins" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="⌖" android:textColor="@color/green" android:textSize="21sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lịch sử check-in" android:textColor="@color/ink"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/muted" android:textSize="24sp"/></LinearLayout>
  <LinearLayout android:id="@+id/profile_vouchers" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp"><TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="🎟" android:textSize="19sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Voucher của tôi" android:textColor="@color/ink"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/muted" android:textSize="24sp"/></LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/logout_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="Đăng xuất" android:textColor="@color/white" app:backgroundTint="#B8403A" app:cornerRadius="14dp"/>
 </LinearLayout>
</LinearLayout></ScrollView>
