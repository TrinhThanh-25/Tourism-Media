<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F4EC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical"><TextView android:id="@+id/home_greeting" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tourism Media" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/><TextView android:id="@+id/home_avatar" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_hero" android:gravity="center" android:text="TM" android:textColor="@color/white" android:textStyle="bold"/></LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="8dp" android:background="@drawable/bg_hero" android:clipToOutline="true">
   <ImageView android:id="@+id/home_hero_image" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Ảnh hành trình nổi bật" android:scaleType="centerCrop"/>
   <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_image_scrim"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom" android:orientation="vertical" android:padding="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HÀNH TRÌNH DÀNH CHO BẠN" android:textColor="#DFF2E7" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Chạm vào những\nmiền đất mới." android:textColor="@android:color/white" android:textSize="30sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Khám phá thiên nhiên, ẩm thực và những góc thành phố đầy cảm hứng." android:textColor="#EEF8F1" android:textSize="14sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_explore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Khám phá ngay →" android:textColor="#3A2B13" app:backgroundTint="#FFB84D" xmlns:app="http://schemas.android.com/apk/res-auto"/>
   </LinearLayout>
  </FrameLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:text="Điểm đến nổi bật" android:textColor="#17332B" android:textSize="20sp" android:textStyle="bold"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
 </LinearLayout>
</ScrollView>
