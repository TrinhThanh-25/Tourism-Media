<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chuyến đi" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/><com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/add_trip" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Tạo chuyến đi" app:backgroundTint="@color/white" app:fabCustomSize="44dp" app:srcCompat="@android:drawable/ic_input_add" app:tint="@color/forest"/></LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Hành trình của bạn" android:textColor="@color/ink" android:textSize="29sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Lên kế hoạch, chia sẻ và lưu giữ những chuyến đi." android:textColor="@color/muted"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:gravity="start"><com.google.android.material.button.MaterialButton android:id="@+id/trips_tab_mine" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Của tôi" app:backgroundTint="@color/forest" app:cornerRadius="22dp"/><com.google.android.material.button.MaterialButton android:id="@+id/trips_tab_saved" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:text="Đã lưu" android:textColor="@color/muted" app:backgroundTint="@color/white" app:cornerRadius="22dp"/><com.google.android.material.button.MaterialButton android:id="@+id/trips_tab_community" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:text="Cộng đồng" android:textColor="@color/muted" app:backgroundTint="@color/white" app:cornerRadius="22dp"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:gravity="center_vertical"><EditText android:id="@+id/trips_search_input" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_card" android:hint="Tìm theo tên địa phương, địa điểm..." android:imeOptions="actionSearch" android:importantForAutofill="no" android:inputType="text" android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/muted"/><com.google.android.material.button.MaterialButton android:id="@+id/trips_sort" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:contentDescription="Chọn cách sắp xếp chuyến đi" android:minWidth="0dp" android:text="Mới nhất" android:textColor="@color/forest" app:strokeColor="@color/line"/></LinearLayout>
 <TextView android:id="@+id/trips_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:gravity="center" android:padding="28dp" android:text="🧭\n\nChưa có chuyến đi\nTạo một hành trình mới hoặc khám phá cộng đồng." android:textAlignment="center" android:textColor="@color/muted" android:textSize="16sp" android:visibility="gone"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/trips_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:clipToPadding="false"/>
</LinearLayout>
