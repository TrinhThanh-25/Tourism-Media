# Tourism Media local environment
# Copy this file to `.env` at the repository root, then adjust values for your machine.

# Backend runtime data remains inside Travel-App-Server.
DB_PATH=./data/travel_app.db
UPLOAD_DIR=./data/uploads

# Addresses reachable from Android. Use 10.0.2.2 for the standard emulator;
# use the host machine's LAN IP for a physical device. Keep both values on the
# same host/port so API requests and uploaded-image URLs work on that device.
TOURISM_API_BASE_URL=http://10.0.2.2:3000/
PUBLIC_BASE_URL=http://10.0.2.2:3000
PORT=3000

# Required. Generate a private random value and never commit `.env`.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Optional comma-separated emails promoted to admin during startup.
ADMIN_EMAILS=

# Native Android does not send browser CORS headers. The wildcard keeps local
# demo clients portable; use an explicit origin if a browser client is added.
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Chatbot: Gemini free tier through Google's OpenAI-compatible API by default.
# Create a key at https://aistudio.google.com/app/apikey and keep it only in `.env`.
# To switch provider, change BASE_URL, API_KEY, MODEL and API_STYLE; Android does
# not need to be rebuilt. API_STYLE accepts chat_completions or responses.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=replace-with-your-provider-api-key
AI_MODEL=gemini-3.1-flash-lite
AI_API_STYLE=chat_completions
# Used only when AI_API_STYLE=responses. Set none to omit reasoning options.
AI_REASONING_EFFORT=none
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT_MAX=20
