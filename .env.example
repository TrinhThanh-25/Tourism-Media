### Tourism Media local environment
### Copy this file to `.env` at the repository root and adjust for your machine.

# Backend runtime data remains inside Travel-App-Server.
DB_PATH=./data/travel_app.db
UPLOAD_DIR=./data/uploads

# Address reachable from Android. Use 10.0.2.2 for the standard emulator;
# use the host machine's LAN IP for a physical device.
PUBLIC_BASE_URL=http://10.0.2.2:3000
PORT=3000

# Required. Generate a private random value and never commit `.env`.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated emails promoted to admin during startup.
ADMIN_EMAILS=admin@example.com

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
